# Copy this file to `.env` (same folder) and adjust if needed.
# Matches the `postgres` service of the root docker-compose.yml (PostgreSQL >= 15).
DATABASE_URL="postgresql://lily:lily@localhost:5432/lily"

# Secret used to sign session tokens. Generate one with: openssl rand -hex 32
JWT_SECRET="change-me"

# Port of the API (the web dev server proxies /api to it).
PORT=3000
