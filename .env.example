# Production stack (docker-compose.prod.yml): copy to `.env` and fill in.
# Development settings live in apps/api/.env (see apps/api/.env.example).

# Database password. URL-safe characters only, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Session signing key, e.g.: openssl rand -hex 32
JWT_SECRET=

# ":80" serves plain HTTP. A domain (e.g. lily.example.com) whose DNS points
# at this machine makes Caddy serve HTTPS with automatic certificates.
SITE_ADDRESS=:80
# Host ports (80 and 443 by default).
HTTP_PORT=80
HTTPS_PORT=443
